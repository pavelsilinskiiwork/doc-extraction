# Copy to .env and fill in what you use. Never commit .env.
# Values without quotes and without spaces around "=".

# anthropic | groq | bedrock
LLM_PROVIDER=groq

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# AWS Bedrock (Converse API)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Storage and review (optional) ---
# Without DATABASE_URL the API is stateless. docker compose sets it for you.
# Quick local run without Docker: DATABASE_URL=sqlite:///extractions.db
# DATABASE_URL=postgresql+psycopg://extract:extract@localhost:5432/extractions
# POSTGRES_PASSWORD=change-me            (used by docker compose)

# When set, every endpoint except /health needs the header  X-API-Key: <value>
# API_KEY=

# Invoices with a total at or above this go to the review queue (in the invoice's own currency)
# REVIEW_TOTAL_THRESHOLD=10000
